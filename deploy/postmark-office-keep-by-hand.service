[Unit]
Description=Postmark office — the keeping tick, run BY HAND (same script; recorded as by-hand, never as the schedule)

[Service]
Type=oneshot
# Runs as the office user: the clones, the stamp key and the panes webroot are
# meepo's. This User= line is load-bearing — the 2026-07-09 tick outage was a
# repo copy of the tick's unit drifting rootward from the live one.
User=meepo
EnvironmentFile=/etc/postmark-office.env
WorkingDirectory=/srv/postmark-office
# The keeping half of the old office tick (POS-268 split it, 2026-09-27). It
# touches neither office.db nor world.db; postmark-office-rehydrate does that,
# two minutes later, from the clones this pulled. The ferry, the pen and both
# halves share the one town lock.
# THE HAND RUN (POS-524, Wright 2026-10-13): the keeping tick exactly as
# postmark-office-keep.service runs it, recorded as source "by-hand" in the
# keep receipt. A by-hand run never extends or clears a scheduled step's
# streak, so a manual success cannot mask the timer's failure. No timer
# triggers this unit: `systemctl start postmark-office-keep-by-hand.service`.
Environment=POSTMARK_KEEP_SOURCE=by-hand
ExecStart=/bin/sh /srv/postmark-office/deploy/office-keep.sh
