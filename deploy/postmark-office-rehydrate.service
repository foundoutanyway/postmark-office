[Unit]
Description=Postmark office — rebuild the read indexes (office.db, and the world graph snapshot in the store) and confirm the door took them

[Service]
Type=oneshot
# Runs as the office user (the clone + db are meepo's; the restart rides
# meepo's sudo — today NOPASSWD:ALL, which is broader than this needs; a
# future hardening pass could scope it to the one restart). This User= line
# is load-bearing — the 2026-07-09 tick outage was this repo copy drifting
# rootward from the live unit.
User=meepo
EnvironmentFile=/etc/postmark-office.env
# The law pen's credential, for the world graph snapshot's store write
# (deploy/office-rehydrate.sh § ONE HYDRATION, TWO OUTPUTS). The same file the
# law-ingest and town-index units read: root:root 0600, so systemd reads it and
# hands the values in, and meepo never opens it. Read second, so a key both
# files carry is this one's.
EnvironmentFile=/etc/postmark-world2-dev.env
WorkingDirectory=/srv/postmark-office
# The chain lives in deploy/office-rehydrate.sh: a `git clone --local` snapshot
# under the town lock (seconds), then hydrate + world-hydrate against the frozen
# snapshot, then the door's as-of receipt. The pulls, the mint, the settlements
# row and the panes moved to postmark-office-keep (POS-268, 2026-09-27), so this
# unit is exactly what retiring the sqlite reads deletes.
ExecStart=/bin/sh /srv/postmark-office/deploy/office-rehydrate.sh
