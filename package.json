{
  "name": "postmark-office",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Postmark's post office — the API/MCP front door. Read shadow + letter enqueue; the town repo stays the constitution.",
  "scripts": {
    "test": "node --import ./test/helpers/sparse-guard.mjs --test --test-concurrency=8 --test-timeout=180000 \"test/*.test.mjs\"",
    "hydrate:world": "node src/world-hydrate.mjs",
    "world:lints": "node src/world-lints.mjs",
    "world:shadow": "node tools/world-shadow.mjs",
    "world:store": "node src/world-serve.mjs",
    "world:gexf": "node tools/world-gexf.mjs",
    "dynamic:store": "node src/dynamic-store.mjs",
    "crossing:save": "node tools/crossing-save.mjs",
    "world:drain": "node src/world-drain.mjs",
    "town:drain": "node tools/town-drain-run.mjs",
    "crossing:replay-check": "node tools/crossing-replay-check.mjs",
    "serve": "node src/server.mjs",
    "smoke": "node src/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-gexf": "^0.13.2",
    "js-yaml": "^4.1.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
